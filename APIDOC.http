
# =========== Expense v1 Authentication Endpoints ==============

# api call for user authentication
###
POST http://127.0.0.1:8000/v1/spending/register/
Content-Type: application/json

{
    "username":"python",
    "email":"python@gmail.com",
    "password":"python123"
}

# api call for token creation
###
POST http://127.0.0.1:8000/v1/spending/token/
Content-Type: application/json

{
    "username":"django",
    "password":"django123"
}

# api call for listing user
###
GET http://127.0.0.1:8000/v1/spending/me/
Accept: application/json
Authorization: Basic react:react123


# =========== ExpenseV1 CRUD Endpoints ==============

# api call for listing expense details
###
GET http://127.0.0.1:8000/v1/spending/expenses/
Accept: application/json
Authorization: Token d04371062133e8cad3ffb9f2f361f0d3bf8f9e7a

# api call for creating expense details
###
POST http://127.0.0.1:8000/v1/spending/expenses/
Content-Type: application/json
Authorization: Token d04371062133e8cad3ffb9f2f361f0d3bf8f9e7a

{
    "title":"food",
    "amount":7000,
    "category":"FOOD",
    "priority":"need",
    "payment_method":"cash"
}

# api call for listing one expense details
###
GET http://127.0.0.1:8000/v1/spending/expenses/1/
Accept: application/json
Authorization: Token d04371062133e8cad3ffb9f2f361f0d3bf8f9e7a

# api call for updating one expense detail
###
PUT http://127.0.0.1:8000/v1/spending/expenses/1/
Content-Type: application/json
Authorization: Token d04371062133e8cad3ffb9f2f361f0d3bf8f9e7a

{
  "id": 5,
  "owner": "react",
  "title": "turf split",
  "amount": "120.00",
  "category": "BILLS",
  "priority": "want",
  "payment_method": "upi",
  "created_at": "2026-10-12T05:39:37.738423Z",
  "updated_at": "2026-10-12T05:39:37.738423Z"
}

# api call for deleting one expense detail
###
DELETE http://127.0.0.1:8000/v1/spending/expenses/4/
Accept: application/json
Authorization: Token d04371062133e8cad3ffb9f2f361f0d3bf8f9e7a

# api call for summary
###
GET http://127.0.0.1:8000/v1/spending/expenses/summary/
Accept: application/json
Authorization: Token d04371062133e8cad3ffb9f2f361f0d3bf8f9e7a

# api call for budget plan
###
GET http://127.0.0.1:8000/v1/spending/expenses/budget/
Accept: application/json
Authorization: Token d04371062133e8cad3ffb9f2f361f0d3bf8f9e7a